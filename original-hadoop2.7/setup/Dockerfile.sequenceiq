# task 이미지 (x86 기본) — 원 저자 이미지 sequenceiq/hadoop-docker:2.4.0 그대로 + 우리 클러스터 설정만 넣음
# 원본 그대로: CentOS 6.5 + Oracle JDK 7u51 (/usr/java/default) + 안쪽 Hadoop 2.4.0 (/usr/local/hadoop)
#   [원 README "tested 2.4.0", YarnConfiguration.java:1009]
# 바꾼 것: 이미지 안 설정 파일만 우리 클러스터 값으로 (HDFS 주소 등) — x86 03 §7 (2026-11-05, 2.7.3 교체본 제거)
# base: fetch-sequenceiq-image.py로 받아 docker load한 sequenceiq/hadoop-docker:2.4.0 (x86 전용)
FROM sequenceiq/hadoop-docker:2.4.0
# build-image.sh가 공통으로 넘기는 값 (Docker 1.12는 안 쓰는 build-arg가 있으면 빌드 실패 → 선언만)
ARG JAVA8_HOME

COPY conf/*.xml /usr/local/hadoop/etc/hadoop/
