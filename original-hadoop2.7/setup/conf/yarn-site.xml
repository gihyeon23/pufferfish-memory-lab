<?xml version="1.0"?>
<!-- 원 구현(YARN 2.7.3) 단일 노드 — 호스트와 task 이미지가 같은 파일을 씀. HOST·HOME 자리는 build-image.sh가 채움 -->
<configuration>
  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>@HOST@</value>
  </property>
  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
  </property>

  <!-- DockerContainerExecutor: task를 Docker 컨테이너에서 실행 (원 README) -->
  <property>
    <name>yarn.nodemanager.container-executor.class</name>
    <value>org.apache.hadoop.yarn.server.nodemanager.DockerContainerExecutor</value>
  </property>
  <property>
    <name>yarn.nodemanager.docker-container-executor.exec-name</name>
    <value>/usr/bin/docker</value>
  </property>
  <property>
    <name>yarn.nodemanager.docker-container-executor.image-name</name>
    <value>local/hadoop-docker:2.4.0-sequenceiq</value>
  </property>
  <!-- env-whitelist는 원 기본값 그대로 (x86 03 §7): DCE가 실행 스크립트에서 JAVA_HOME·HADOOP_*를 빼므로
       task는 이미지 ENV(JDK 7u51, Hadoop 2.4.0)를 씀 (DockerContainerExecutor.java:315-320) -->


  <!-- 노드 자원: YARN_MB·JVM_MB 자리는 build-image.sh가 채움
       x86 워커(32GB) 기본 28672 / 16384 — x86-server/steps/01 §3, 맥 VM(3GB)은 YARN_MB=2048 -->
  <property>
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>@YARN_MB@</value>
  </property>
  <property>
    <name>yarn.nodemanager.resource.cpu-vcores</name>
    <value>8</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-mb</name>
    <value>@YARN_MB@</value>
  </property>
  <!-- minimum-allocation-mb는 Hadoop 기본 1024 (맥 VM용 256 제거, 2026-11-06) -->
  <!-- vmem 검사 끔: Flex 컨테이너는 1~2GB에 -Xmx16g라 가상 메모리 한도(×2.1)를 넘음 (추측, 맥부터 유지) -->
  <property>
    <name>yarn.nodemanager.vmem-check-enabled</name>
    <value>false</value>
  </property>

  <!-- Pufferfish MAX_HEAP: Flex 컨테이너 -Xmx를 이 값으로 치환 (원 코드 기본 65536 = 논문 64GB, YarnConfiguration.java:848) -->
  <property>
    <name>yarn.nodemanager.balloon.jvm-mb</name>
    <value>@JVM_MB@</value>
  </property>
  <!-- puff 주기 2초 (논문 p.263). 원 코드 Java 기본은 2000인데 yarn-default.xml이 3000으로 덮어씀 -->
  <property>
    <name>yarn.nodemanager.container-monitor.interval-ms</name>
    <value>2000</value>
  </property>
  <!-- 나머지 balloon.*는 원 코드 기본값: ratio 0.4 / stop 0.8 / reclaim 0.9 / memory-mb -1 -->
</configuration>
